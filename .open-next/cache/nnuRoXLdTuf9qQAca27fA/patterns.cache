1.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"></path></svg></button></div><div class=\"page-vignette\" aria-hidden=\"true\"></div><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script src=\"/_next/static/chunks/3vyexbew-kal_.js\" id=\"_R_\" async=\"\"></script><div hidden id=\"S:0\"><div class=\"bg-deep-black min-h-screen\"><header class=\"relative flex items-end min-h-[70vh]\"><div class=\"cinematic-wrap absolute inset-0 ken-burns-slow film-grain\"><img src=\"https://res.cloudinary.com/b9oo5abp/image/upload/f_auto,q_auto:good,w_1920,c_limit/kalki-mirror/tantra/hero-mountain-trident\" alt=\"Pattern Atlas\" loading=\"eager\" decoding=\"sync\" draggable=\"false\" class=\"cinematic-img-fill\"/><div class=\"absolute inset-0 pointer-events-none\" style=\"z-index:1;background:linear-gradient(to top, rgba(11,12,16,0.98) 0%, rgba(11,12,16,0.7) 30%, rgba(11,12,16,0.15) 70%, transparent 100%)\"></div><div class=\"absolute pointer-events-none\" style=\"z-index:2;top:-20%;left:30%;width:40%;height:80%;background:linear-gradient(180deg, rgba(197,160,89,0.04) 0%, rgba(197,160,89,0.01) 40%, transparent 100%);transform:rotate(8deg);filter:blur(40px)\"></div><div class=\"dust-overlay\" style=\"z-index:2\"></div><div class=\"absolute inset-0 pointer-events-none\" style=\"z-index:3;background:radial-gradient(ellipse 70% 60% at 50% 50%, transparent 50%, rgba(0,0,0,0.45) 100%)\"></div></div><div class=\"relative z-10 w-full max-w-[1400px] mx-auto px-6 lg:px-10 pb-20 md:pb-28 pt-32\"><p class=\"section-label mb-6\" style=\"opacity:0;transform:translateY(30px)\">The Mirror Method</p><h1 class=\"font-display text-4xl md:text-6xl lg:text-7xl text-white leading-[0.95] tracking-[0.06em] mb-5 hero-heading\" style=\"opacity:0;transform:translateY(30px)\">Pattern Atlas</h1><p class=\"text-foreground text-xl md:text-2xl max-w-3xl editorial-spacing\" style=\"text-shadow:0 1px 8px rgba(0,0,0,0.6);opacity:0;transform:translateY(30px)\">The emotional patterns that run your life — and the sādhanas designed to dissolve them.</p></div></header><div class=\"max-w-[1400px] mx-auto px-6 lg:px-10 py-20 md:py-28\"><div class=\"mb-10\" style=\"opacity:0;transform:translateY(30px)\"><a class=\"inline-flex items-center gap-2 text-gold-dim hover:text-gold text-xs font-ui tracking-[0.12em] uppercase transition-colors duration-300 group\" href=\"/\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" class=\"transition-transform duration-300 group-hover:-translate-x-1\"><path d=\"M19 12H5M12 19l-7-7 7-7\"></path></svg>Back to Home</a></div><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\" style=\"opacity:0\"><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-rescuer\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Rescuer</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Saving others to avoid the self</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You feel anxious when others solve their own problems</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->Relationships feel one-sided — you give, they take</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You cannot ask for help without guilt</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-perfectionist\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Perfectionist</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Controlling outcomes to control anxiety</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You procrastinate because starting imperfectly feels like failure</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You micromanage tasks others could handle</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->Your inner critic speaks louder than anyone else</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-ghost\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Ghost</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Fading out to avoid conflict</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You say &quot;I&#x27;m fine&quot; when you are not</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->Your preferences feel like impositions on others</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You ghost people rather than express disappointment</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-controller\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Controller</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Gripping tight because letting go feels like dying</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You feel physical tension when plans change unexpectedly</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You correct people even when it does not matter</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->Delegation feels like abdication</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-hermit\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Hermit</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Withdrawing because the world is too much</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You cancel plans at the last minute to stay home</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You feel exhausted by social interaction even with friends</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You convince yourself you do not need anyone</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-chameleon\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Chameleon</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Becoming what others need you to be</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->Your personality shifts depending on who you are with</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You agree with opinions you privately disagree with</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You feel like a fraud even when complimented</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-saboteur\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Saboteur</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Destroying what you secretly want</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You quit right before a breakthrough</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You pick fights the night before something important</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You overspend, overdrink, or distract yourself at the finish line</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-avoidant\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Avoidant</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Numbing because feeling is too risky</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You fill every silence with screens, tasks, or noise</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You intellectualize emotions instead of feeling them</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->People call you &quot;chill&quot; or &quot;laid back&quot; but you feel dead inside</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-martyr\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Martyr</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Suffering as proof of worthiness</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You feel guilty when resting</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You brag about how little sleep you get</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You use exhaustion as evidence of your value</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-pleaser\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Pleaser</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Agreeing to survive, never to thrive</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You apologize before speaking</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You cannot say &quot;no&quot; without a paragraph of explanation</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You mold your opinions to match the group</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-positivist\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Positivist</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Spiritual bypass through forced optimism</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You say &quot;everything happens for a reason&quot; before processing pain</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You judge others for being negative</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You scroll past suffering because it &quot;lowers your vibration&quot;</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div><div><a class=\"glass-chip group flex flex-col\" href=\"/patterns/the-architect\"><div class=\"p-6 md:p-8\"><h3 class=\"font-display text-xl md:text-2xl text-foreground leading-tight tracking-tight mb-2 group-hover:text-gold transition-colors duration-500 font-light\">The Architect</h3><p class=\"text-sm text-gold-dim mb-6 font-mono tracking-wider\">Over-thinking instead of over-living</p><div class=\"divider-subtle mb-5\"></div><ul class=\"space-y-2\"><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You have read more about meditation than you have meditated</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You plan endlessly but rarely execute</li><li class=\"text-sm text-text-secondary font-ui tracking-wide leading-relaxed\">· <!-- -->You collect frameworks, systems, and certifications instead of doing the work</li></ul><div class=\"mt-5 pt-3 border-t border-gold/5\"><span class=\"font-mono text-[0.75rem] tracking-[0.15em] uppercase text-copper\">YANTRA PATTERN · <!-- -->2<!-- --> SIDDHIS LINKED</span></div></div></a></div></div></div></div><!--$--><!--/$--></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if(\"/$\"===d||\"/&\"===d)if(0===h)break;else h--;else\"$\"!==d&&\"$?\"!==d&&\"$~\"!==d&&\"$!\"!==d&&\"&\"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data=\"$\";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};\n$RC=function(a,b){if(b=document.getElementById(b))(a=document.getElementById(a))?(a.previousSibling.data=\"$~\",$RB.push(a,b),2===$RB.length&&(\"number\"!==typeof $RT?requestAnimationFrame($RV.bind(null,$RB)):(a=performance.now(),setTimeout($RV.bind(null,$RB),2300>a&&2E3<a?2300-a:$RT+300-a)))):b.parentNode.removeChild(b)};$RC(\"B:0\",\"S:0\")</script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:I[39756,[\\\"/_next/static/chunks/0uwzk1kp0d5yk.js\\\",\\\"/_next/static/chunks/38rkff5lkyuby.js\\\",\\\"/_next/static/chunks/18ifcb06zs14a.js\\\",\\\"/_next/static/chunks/0nf4ok-vzfe2y.js\\\"],\\\"LoadingBoundaryProvider\\\"]\\n2:\\\"$Sreact.fragment\\\"\\n3:I[23236,[\\\"/_next/static/chunks/0uwzk1kp0d5yk.js\\\",\\\"/_next/static/chunks/38rkff5lkyuby.js\\\",\\\"/_next/static/chunks/18ifcb06zs14a.js\\\",\\\"/_next/static/chunks/0nf4ok-vzfe2y.js\\\"],\\\"TierProvider\\\"]\\n4:I[19017,[\\\"/_next/static/chunks/0uwzk1kp0d5yk.js\\\",\\\"/_next/static/chunks/38rkff5lkyuby.js\\\",\\\"/_next/static/chunks/18ifcb06zs14a.js\\\",\\\"/_next/static/chunks/0nf4ok-vzfe2y.js\\\"],\\\"SmoothScroll\\\"]\\n5:I[27644,[\\\"/_next/static/chunks/0uwzk1kp0d5yk.js\\\",\\\"/_next/static/chunks/38rkff5lkyuby.js\\\",\\\"/_next/static/chunks/18ifcb06zs14a.js\\\",\\\"/_next/static/chunks/0nf4ok-vzfe2y.js\\\"],\\\"SacredNav\\\"]\\n6:I[39756,[\\\"/_next/static/chunks/0uwzk1kp0d5y