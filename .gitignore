# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# database backups (dumps contain password hashes — NEVER commit)
backups/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# AstroKalki specific
tool-results/
upload/
scripts/*
# geo-ops monitoring code ships with the repo (exception to scripts/ ignore)
!scripts/geo-ops/
scripts/geo-ops/logs/
# db backup engine ships with the repo (npm run db:backup — exception to scripts/ ignore)
!scripts/backup-db.sh
!scripts/backup-db.mjs
# FolioChunk embedding baker ships with the repo (Leak L4 — corpus re-bake on change)
!scripts/bake-folio-embeddings.ts
# Tier-1 schema delta applier ships with the repo (migration record)
*.zip
cloudinary-map.json.open-next/

# download artifacts (design mockups, proposals, screenshots)
/download/

# Playwright E2E artifacts
playwright-report/
test-results/
bun.lock
