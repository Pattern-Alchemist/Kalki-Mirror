# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# GitHub PAT store (docs/security/credential-rotation-runbook.md §1 — helper
# scripts read it from here; the runbook claimed this was already excluded)
.gh_token

# database backups (dumps contain password hashes — NEVER commit)
backups/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# AstroKalki specific
tool-results/
upload/
scripts/*
# geo-ops monitoring code ships with the repo (exception to scripts/ ignore)
!scripts/geo-ops/
scripts/geo-ops/logs/
# db backup engine ships with the repo (npm run db:backup — exception to scripts/ ignore)
!scripts/backup-db.sh
!scripts/backup-db.mjs
# Vol. 4 #2 — the scripts/* rule silently swallowed TWO shipped files
# (restore-drill.sh Vol.2 #13, run-e2e.sh Vol.3 #16). Everything the repo's
# own workflows and package.json reference must be tracked:
!scripts/restore-drill.sh
!scripts/restore-drill.mjs
!scripts/run-e2e.sh
!scripts/seed-admin.cjs
# FolioChunk embedding baker ships with the repo (Leak L4 — corpus re-bake on change)
!scripts/bake-folio-embeddings.ts
# Tier-1/2 schema delta appliers ship with the repo (migration records)
!scripts/apply-tier1-schema.ts
!scripts/apply-tier2-schema.ts
# Vol. 4 #11 — the OG render smoke (satori pipeline check before deploy)
!scripts/og-smoke.mjs
# Vol. 4 #12 — the audio pilot: narration scripts (data) + the TTS baker
!scripts/breathwork-narrations.mjs
!scripts/bake-breathwork-audio.mjs
# Vol. 4 #13 — the hi corpus bridge insertion tool (translation provenance)
!scripts/add-hi-bridge.py
# Vol. 4 #16 — the neural-swap rehearsal (keyless precondition checks) + its
# fingerprint probe (both ship with the repo; the scripts/* rule would swallow them)
!scripts/rehearse-neural-swap.sh
!scripts/neural-swap-fingerprint.ts
*.zip
cloudinary-map.json.open-next/

# download artifacts (design mockups, proposals, screenshots)
/download/

# Playwright E2E artifacts
playwright-report/
test-results/
bun.lock

# E2E auth state (minted by e2e/auth.setup.ts, never committed)
e2e/.auth/
db/e2e-local.db*

# founder local env (no leading dot — .env* does not cover it)
env.local
!scripts/audit-credentials.sh
!scripts/smoke-ask.sh
!scripts/apply-vol5-schema.ts
