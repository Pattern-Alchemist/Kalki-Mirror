# ============================================================================
# KALKI MIRROR — local environment template
# Copy to .env.local and fill in real values. .env* is gitignored — NEVER
# commit real credentials (the production DB token was once hardcoded in this
# public repo; that debt is cleared — keep it cleared).
# ============================================================================

# ── Database (Turso / libSQL) ────────────────────────────────────────────────
# Required for admin auth (src/lib/auth.ts reads these directly) and for
# runtime writes via Prisma (src/lib/db.ts). Without them the site renders,
# but admin login fails loud with AUTH_DB_UNCONFIGURED.
# Rotate = new token in Turso dashboard → update here AND in Vercel env vars.
TURSO_DATABASE_URL=libsql://your-db-your-org.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-libsql-auth-token

# Prisma development fallback (local SQLite) — used only when TURSO_DATABASE_URL
# is unset. Copy db/custom.db or run `npm run db:push` to create a fresh one.
# DATABASE_URL=file:./db/custom.db

# ── Auth (NextAuth v4) ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=openssl-rand-base64-32

# ── Media (Cloudinary) ───────────────────────────────────────────────────────
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Ops / automation ─────────────────────────────────────────────────────────
# Site origin used by cron pings and SEO routes:
# SITE_URL=http://localhost:3000
# Bearer secret required by /api/indexnow cron:
# CRON_SECRET=
# Comma-separated IPs/CIDRs allowed to reach /admin when set (empty = open):
# ALLOWED_ADMIN_IPS=
# Set to 1 to log every Prisma query:
# PRISMA_LOG=1

# ── Tier 2: ops resilience ───────────────────────────────────────────────
# Distributed rate limiting (Upstash Redis free tier). When both are set
# the limiter becomes cross-instance; otherwise it falls back to
# in-memory per process. Provision: Upstash console or the Vercel
# Marketplace → copy the REST URL + token here.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Tier 3: growth surfaces ──────────────────────────────────────────────
# Cal.com booking handoff (roadmap #13). Set to your free-tier booking
# link (https://cal.com/<user>/<event> or bare <user>/<event>) and the
# wizard's success panel gains "Step 3 · Claim your time slot". Runtime
# read → no rebuild. Unset = the panel stays WhatsApp/UPI-only.
# CAL_BOOKING_URL=

# Resend webhook receiver (/api/webhooks/resend). The whsec_ secret is
# returned when the webhook is created in the Resend dashboard/API.
# RESEND_WEBHOOK_SECRET=

# Ops email routing: daily digest recipient (falls back to the doors
# sender address when unset) and GitHub-Actions uptime alerts.
# DIGEST_TO=you@example.com
# RESEND_ALERT_TO=you@example.com
