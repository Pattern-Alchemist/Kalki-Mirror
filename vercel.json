{
  "git": {
    "deploymentEnabled": true
  },
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/course-send",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "45 3 * * *"
    }
  ]
}