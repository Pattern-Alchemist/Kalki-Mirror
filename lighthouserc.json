{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3456",
      "startServerReadyPattern": "Ready",
      "numberOfRuns": 1,
      "url": [
        "http://localhost:3456/",
        "http://localhost:3456/karma",
        "http://localhost:3456/archetypes",
        "http://localhost:3456/patterns",
        "http://localhost:3456/archive",
        "http://localhost:3456/aghori-tantra",
        "http://localhost:3456/usa",
        "http://localhost:3456/usa/austin",
        "http://localhost:3456/usa/vedic-astrology-consultation",
        "http://localhost:3456/glossary",
        "http://localhost:3456/letters",
        "http://localhost:3456/hi/glossary/om"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.45 }],
        "categories:accessibility": ["error", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.7 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance:lcp": "off",
        "categories:performance:tbt": "off",
        "categories:performance:cls": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
