generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// KALKI DATA ARCHITECTURE — Persistence Split
//
// TWO DATABASE CLIENTS, ONE SCHEMA:
//
// 1. staticDb (src/lib/static-db.ts)
//    - Reads ONLY FolioChunk from the baked db/custom.db
//    - On Vercel: copies to /tmp/kalki-corpus.db at cold start
//    - 279 chunks, immutable, committed as a read-only asset
//
// 2. db (src/lib/db.ts)
//    - Reads/writes User, SadhanaStreak, PatternResolution, InviteCode, InviteUsage
//    - Dev: local SQLite via DATABASE_URL
//    - Production: Turso via @prisma/adapter-libsql (TURSO_DATABASE_URL + TURSO_AUTH_TOKEN)
//
// WHY: Vercel's serverless filesystem is read-only. SQLite writes evaporate
// between invocations and are not shared across function instances.
// The FolioChunk corpus never changes at runtime — bake it, ship it, read it.
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  tier          String    @default("prithvi") // prithvi, jal, agni, akash
  natalMoonLng  Float?   // Vedic Moon longitude at birth (0-360)
  birthDate     DateTime?
  birthPlace    String?
  invitedByCode String?   // The Golden Key used to enter
  goldKeysRemaining Int     @default(0) // Remaining keys to transmit
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  streaks       SadhanaStreak[]
  resolutions    PatternResolution[]
  keysGenerated InviteCode[]  @relation("GeneratedKeys")
  keysUsed      InviteUsage[]    @relation("UsedKeys")
}

// ============================================================
// SĀDHANA STREAKS — Longitudinal practice tracking
// Tracks consecutive days of practice per sādhana.
// Allows YANTRA to say: "40 days in the Rescuer loop.
// The geometry is shifting."
// ============================================================

model SadhanaStreak {
  id        String   @id @default(cuid())
  userId    String
  practice  String   // Practice slug (e.g. "nadi-shuddhi-basic")
  practiceName String  // Display name (e.g. "Nadi Suddhi")
  currentStreak Int    @default(0)
  longestStreak  Int    @default(0)
  totalDays    Int    @default(0)
  lastPracticedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, practice])
}

// ============================================================
// PATTERN RESOLUTIONS — When a behavioral loop is integrated
// The user marks a pattern as resolved, creating a karmic record.
// ============================================================

model PatternResolution {
  id          String   @id @default(cuid())
  userId      String
  patternSlug String   // e.g. "the-rescuer"
  patternName String   // e.g. "THE RESCUER"
  recognizedAt DateTime // When the pattern was first identified
  resolvedAt   DateTime // When the subject marked it integrated
  daysToResolve Int     // How long the integration took
  notes       String?  // The subject's own summary
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, patternSlug])
}

// ============================================================
// GOLDEN KEY SYSTEM — The Velvet Rope
// Master Keys are generated by the Archivist.
// Each Initiate receives 3 keys to transmit.
// Keys are single-use. The geometry of exclusivity.
// ============================================================

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique // The actual key (e.g. "KALKI-7X3R-M9VK")
  createdBy   String   // User ID who generated it
  tierGranted String   @default("jal") // Tier this key unlocks
  maxUses    Int      @default(1)
  usesUsed   Int      @default(0)
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  creator  User          @relation("GeneratedKeys", fields: [createdBy], references: [id])
  usages   InviteUsage[]

  @@index([code])
}

// ============================================================
// FOLIO CHUNKS — RAG-Grounded YANTRA Intelligence
// Each siddhi folio is split into semantic sections.
// Embeddings enable two-pool retrieval:
//   Pool P (prescription): OPEN only → feeds prescribed_sadhana
//   Pool C (citation): tier-filtered → feeds archetype + tantric_citation
//
// On SQLite: embedding stored as JSON string, cosine sim in JS.
// Migration path: swap to pgvector with <=> operator when moving to Postgres.
// ============================================================

model FolioChunk {
  id        String  @id @default(cuid())
  slug      String  // siddhi folio slug (e.g. "nadi-shuddhi", "bagalamukhi-sadhana")
  archetype String? // linked archetype id if applicable
  section   String  // summary | benefits | warnings | mantra | lineage | bibliography
  caution   String  // OPEN | MODERATE | HIGH | SEALED
  text      String  // the actual chunk text
  embedding String  @default("[]") // JSON array of floats; empty = use keyword fallback

  @@index([slug])
  @@index([caution])
  @@index([section])
}

model InviteUsage {
  id        String   @id @default(cuid())
  codeId    String
  usedBy   String // User ID who used the key
  usedAt    DateTime @default(now())

  code  InviteCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user  User       @relation("UsedKeys", fields: [usedBy], references: [id], onDelete: Cascade)

  @@index([codeId])
  @@index([usedBy])
}
